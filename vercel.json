{
  "cleanUrls": true,
  "headers": [
    { "source": "/(.*)\\.vcf", "headers": [
      { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
      { "key": "Content-Disposition", "value": "attachment; filename=\"tatiana-munoz.vcf\"" } ] },
    { "source": "/assets/(.*)", "headers": [
      { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" } ] }
  ]
}
